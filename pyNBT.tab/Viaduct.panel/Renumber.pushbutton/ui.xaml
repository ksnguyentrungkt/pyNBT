<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyNBT - Renumber Rebar"
        Height="560" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Renumber Rebar" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Auto-detects Ring / Line / Grid, numbers Mark in reading order" FontSize="11" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#334155" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="v1.2" FontSize="11" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: controls -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Numbering Mode" FontWeight="Bold" FontSize="12" Foreground="#1E293B"/>
                    <RadioButton x:Name="RbGroup" GroupName="Mode" Content="Group identical bars" IsChecked="True" Margin="0,8,0,4"/>
                    <RadioButton x:Name="RbUnique" GroupName="Mode" Content="Unique number per bar" Margin="0,0,0,4"/>

                    <TextBlock Text="Prefix" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtPrefix" Style="{StaticResource InputStyle}" Text=""/>

                    <TextBlock Text="Start Number" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtStartNumber" Style="{StaticResource InputStyle}" Text="1"/>

                    <TextBlock Text="Layout" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="CmbLayout" SelectedIndex="0">
                        <ComboBoxItem Content="Auto (detect automatically)" Tag="auto"/>
                        <ComboBoxItem Content="Ring (circle/square/hexagon)" Tag="ring"/>
                        <ComboBoxItem Content="Line (line/spline)" Tag="line"/>
                        <ComboBoxItem Content="Grid (multiple rows x columns)" Tag="grid"/>
                    </ComboBox>

                    <TextBlock Text="Row Tolerance (mm) - used when Layout is Grid" Style="{StaticResource LabelStyle}" TextWrapping="Wrap"/>
                    <TextBox x:Name="TxtTolerance" Style="{StaticResource InputStyle}" Text="150"/>

                    <Button x:Name="BtnRefresh" Content="Refresh Preview" Style="{StaticResource SecondaryBtn}"
                            Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Right: preview -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Preview" FontWeight="Bold" FontSize="12" Foreground="#1E293B" Margin="0,0,0,8"/>
                    <ListView x:Name="ListPreview" Grid.Row="1" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="No." DisplayMemberBinding="{Binding No}" Width="45"/>
                                <GridViewColumn Header="Element Id" DisplayMemberBinding="{Binding ElementId}" Width="90"/>
                                <GridViewColumn Header="Diameter" DisplayMemberBinding="{Binding Diameter}" Width="80"/>
                                <GridViewColumn Header="Length" DisplayMemberBinding="{Binding Length}" Width="80"/>
                                <GridViewColumn Header="New Mark" DisplayMemberBinding="{Binding NewMark}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="16,10" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="#787878" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecondaryBtn}"/>
                    <Button x:Name="BtnApply" Content="Apply" Style="{StaticResource PrimaryBtn}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
