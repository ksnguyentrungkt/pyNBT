<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyNBT - Excel Data"
        Height="640" Width="900"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="NavyHoverBrush" Color="#2C3E5C"/>
        <SolidColorBrush x:Key="ApplyBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="ApplyHoverBrush" Color="#256428"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="FooterBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="GrayTextBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#787878"/>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavyHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource ApplyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ApplyHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource MutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="22,16,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Excel Data" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sync element parameters through Excel - export, edit, re-import" FontSize="11" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#332C3E5C" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" FontSize="10.5" Foreground="#E6EAF5"/>
                </Border>
            </Grid>
        </Border>

        <!-- Toolbar: mode switch -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="22,10,22,10">
            <StackPanel Orientation="Horizontal">
                <Border Background="#E9EDF2" CornerRadius="8" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnModeExport" Content="Export" Style="{StaticResource SegBtn}" Click="OnModeExport"/>
                        <Button x:Name="btnModeImport" Content="Import" Style="{StaticResource SegBtn}" Click="OnModeImport" Margin="2,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                <Grid Margin="16,16,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="pageExportLeft" Grid.Row="0">
                        <TextBlock Text="SCHEDULE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbSchedule" FontSize="12.5" Padding="8,6" SelectionChanged="OnScheduleChanged"/>

                        <TextBlock Text="DETECTED CATEGORY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6"/>
                        <Border Background="#E8ECF2" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="6" Padding="9,6" HorizontalAlignment="Left">
                            <TextBlock x:Name="txtCategory" Text="-" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource NavyBrush}"/>
                        </Border>

                        <Button x:Name="btnRefreshPreview" Content="Refresh preview" Style="{StaticResource SecondaryBtn}" Click="OnRefreshPreview" Margin="0,18,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel x:Name="pageImportLeft" Grid.Row="0" Visibility="Collapsed">
                        <TextBlock Text="EDITED EXCEL FILE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <Button x:Name="btnPickImportFile" Content="Choose file..." Style="{StaticResource SecondaryBtn}" Click="OnPickImportFile" HorizontalAlignment="Stretch"/>
                        <TextBlock x:Name="txtImportFile" Text="No file selected" FontSize="11.5" Foreground="{StaticResource GrayTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="DETECTED COLUMNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6"/>
                        <TextBlock x:Name="txtMatchedColumns" Text="-" FontSize="11.5" Foreground="{StaticResource GrayTextBrush}" TextWrapping="Wrap" LineHeight="19"/>

                        <CheckBox x:Name="chkPreviewOnly" Content="Preview only - do not write to the model" FontSize="11.5" IsChecked="True" Margin="0,16,0,0" Checked="OnPreviewOnlyChanged" Unchecked="OnPreviewOnlyChanged"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="6" Padding="9,9">
                        <TextBlock x:Name="txtLeftNote" FontSize="10.5" Foreground="{StaticResource GrayTextBrush}" TextWrapping="Wrap" LineHeight="15"
                                   Text="Improvement: ElementId/UniqueId are read directly from each element on export, no longer matched by row position - correct even if the schedule has its own sort/group."/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL -->
            <Grid Grid.Column="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtRightTitle" Grid.Column="0" Text="Schedule preview" FontSize="12.5" FontWeight="Bold" Foreground="#1E1E1E"/>
                    <TextBlock x:Name="txtRightCount" Grid.Column="1" Text="0 rows" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="8" Background="White">
                    <Grid>
                        <DataGrid x:Name="gridExportPreview" AutoGenerateColumns="True" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="26" FontSize="11.5" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HorizontalGridLinesBrush="#EEF1F4" BorderThickness="0" Background="White"/>
                        <DataGrid x:Name="gridImportDiff" AutoGenerateColumns="True" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowHeight="26" FontSize="11.5" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HorizontalGridLinesBrush="#EEF1F4" BorderThickness="0" Background="White"
                                  Visibility="Collapsed" LoadingRow="OnDiffRowLoading"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="22,12,22,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="txtStatus" Grid.Column="0" Text="Ready" FontSize="12" Foreground="{StaticResource GrayTextBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnClose" Content="Close" Style="{StaticResource SecondaryBtn}" Click="OnCloseClick"/>
                        <Button x:Name="btnExport" Content="Export Excel..." Style="{StaticResource PrimaryBtn}" Click="OnExportClick" Margin="8,0,0,0"/>
                        <Button x:Name="btnApply" Content="Import &amp; Update" Style="{StaticResource ApplyBtn}" Click="OnApplyClick" Margin="8,0,0,0" Visibility="Collapsed"
                                ToolTip="Uncheck 'Preview only' on the left to enable this button" ToolTipService.ShowOnDisabled="True"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="pyNBT - Excel Data v1.0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
