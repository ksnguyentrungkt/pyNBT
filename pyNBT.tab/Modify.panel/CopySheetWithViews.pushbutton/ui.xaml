<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyNBT - Copy Sheet + Views"
        Height="680" Width="920"
        MinHeight="520" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F8F9FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="NavyBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="NavyHoverBrush" Color="#2C3E5C"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="GreenHoverBrush" Color="#276A2B"/>
        <SolidColorBrush x:Key="BorderBrush1" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="FooterBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="GrayTextBrush" Color="#4B5563"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#787878"/>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource GrayTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavyHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GreenHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}" Padding="20,16,20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Copy Sheet + Views" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Duplicate sheets together with every view placed on them" FontSize="11" Foreground="#CBD5E1" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#332C3E5C" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="v1.0 - draft" FontSize="10.5" Foreground="#E6EAF5"/>
                </Border>
            </Grid>
        </Border>

        <!-- Options bar -->
        <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="20,12,20,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Duplicate views as:" FontSize="12.5" Foreground="{StaticResource GrayTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="radWithDetailing" Content="With Detailing" GroupName="dupmode" IsChecked="True" FontSize="12.5" VerticalAlignment="Center"/>
                    <RadioButton x:Name="radNoDetailing" Content="Without Detailing" GroupName="dupmode" FontSize="12.5" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>
                <TextBlock Text="Legends and Schedules are always reused on the new sheet, never duplicated." FontSize="10.5" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body: left = sheet checklist, right = pending copy list -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: sheet checklist -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="6" Margin="20,16,20,0" Padding="9,6">
                        <TextBox x:Name="txtSearch" BorderThickness="0" Background="Transparent" FontSize="12.5" TextChanged="OnSearchChanged"/>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,10,20,0">
                        <Button x:Name="btnSelectAll" Content="Select All" Click="OnSelectAll" Style="{StaticResource SecondaryBtn}"/>
                        <Button x:Name="btnSelectNone" Content="Select None" Click="OnSelectNone" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="20,12,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="SHEET" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="VIEWS" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panelSheetList"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: pending sheets to copy -->
            <Border Grid.Column="1" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtPendingHeader" Grid.Row="0" Text="Sheets to copy (0)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GrayTextBrush}" Margin="20,16,20,0"/>

                    <Grid Grid.Row="1" Margin="20,14,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SHEET" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="NEW NUMBER *" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="NEW NAME" FontSize="10" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Margin="0,4,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panelPendingRows" Margin="20,4,20,4"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="20,12,20,16">
            <StackPanel>
                <TextBlock x:Name="txtStatus" Text="Ready" FontSize="12" Foreground="{StaticResource GrayTextBrush}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="btnCancel" Content="Cancel" Click="OnCancel" Style="{StaticResource SecondaryBtn}"/>
                    <Button Grid.Column="1" x:Name="btnCopy" Content="Copy Selected Sheets" Click="OnCopy" Style="{StaticResource ApplyBtn}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="pyNBT - Copy Sheet + Views v1.0" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
